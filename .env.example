# AWS SES (sender must be a verified identity in this region)
AWS_REGION_SYSTEM=us-east-1
AWS_ACCESS_KEY_ID_SYSTEM=
AWS_SECRET_ACCESS_KEY_SYSTEM=
# Optional: SES configuration set for event tracking (bounces, deliveries, opens)
SES_CONFIGURATION_SET=
SES_FROM_EMAIL="NBPHS <no-reply@nbphs.com>"

# Comma-separated inbox(es) that receive contact form submissions
CONTACT_TO_EMAIL=info@nbphs.com

# Public site URL — used for the logo and links inside emails
SITE_URL=https://www.nbphs.com
